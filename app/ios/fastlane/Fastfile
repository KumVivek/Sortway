# Signs the iOS app and uploads it to TestFlight.
#
# Build the Flutter part first (from app/):
#   flutter build ios --release --no-codesign --dart-define-from-file=config/prod.json
# then, from app/ios:
#   bundle exec fastlane beta
#
# Needs these environment variables:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#   APP_STORE_CONNECT_KEY_P8      (contents of the .p8 API key)
#   APPLE_TEAM_ID
#   MATCH_GIT_URL, MATCH_PASSWORD (fastlane match certificate repo)
#   MATCH_GIT_BASIC_AUTHORIZATION (base64 "user:token" for a private repo, CI only)
#
# First time only, on a Mac with your Apple account, create the certificate
# and profile in the match repo:  bundle exec fastlane match appstore

default_platform(:ios)

APP_ID = "com.flowsort.flowSort"

platform :ios do
  desc "Sign, export and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      in_house: false
    )

    match(type: "appstore", app_identifier: APP_ID, readonly: true, api_key: api_key)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_ID}"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      export_options: {
        provisioningProfiles: { APP_ID => "match AppStore #{APP_ID}" }
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
